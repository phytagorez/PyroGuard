APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pyroguard
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# =========================================================================
# KONFIGURASI LAYANAN EKSTERNAL PYROGUARD
# =========================================================================

# [MASUKKAN API KEY DI .ENV] - Google OAuth (Login Petugas & Admin)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/masuk/google/callback"

# [MASUKKAN API KEY DI .ENV] - Telegram Bot API
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=PyroGuardBromo_bot
TELEGRAM_PUBLIC_CHANNEL_ID=@PyroGuard
TELEGRAM_OFFICER_GROUP_ID=
TELEGRAM_WEBHOOK_SECRET=

# [MASUKKAN API KEY DI .ENV] - Open-Meteo Cuaca & Prakiraan Kawasan
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# [MASUKKAN API KEY DI .ENV] - NASA FIRMS Titik Panas Satelit
NASA_FIRMS_API_KEY=
NASA_FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov/api/area/csv

# [MASUKKAN API KEY DI .ENV] - VAPID Web Push Notification
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@pyroguard.id
